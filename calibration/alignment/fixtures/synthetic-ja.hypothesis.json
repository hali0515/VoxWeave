  "cues": [
    {
      "id": "h001",
      "text": "灯台守は嵐の前に眠らない",
      "start": 1.0,
      "end": 4.0
    },
    {
      "id": "h002",
      "text": "彼は波を数えて革の手帳に記録する",
      "start": 4.6,
      "end": 8.4
    },
    {
      "id": "h003",
      "text": "村の誰もその手帳を読まない",
      "start": 9.0,
      "end": 11.9
    },
    {
      "id": "h004",
      "text": "去年の冬に灯りが初めて消えた",
      "start": 12.4,
      "end": 15.6
    },
    {
      "id": "h005",
      "text": "守は港まで降りて提灯を借りた",
      "start": 16.1,
      "end": 19.4
    },
    {
      "id": "h006",
      "text": "それから彼は替えの芯を二本持ち歩く",
      "start": 20.0,
      "end": 23.2
    }
  ]
}
