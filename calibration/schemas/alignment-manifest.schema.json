{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxweave.local/schemas/alignment-manifest.schema.json",
  "title": "voxweave alignment calibration manifest",
  "description": "Input manifest for scripts/calib_alignment.py. Relative paths resolve against the manifest directory; a leading ${VOXWEAVE_CALIB_ROOT} is expanded by the loader, which must confirm the canonical path stays inside that root. Cross-object rules (item.language == reference.language, range end > start, include/exclude union order) are loader-enforced, not expressible here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "data_root_env": {"type": "string", "default": "VOXWEAVE_CALIB_ROOT"},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_hyp_coverage": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.8},
        "min_ref_coverage": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.8},
        "min_pair_similarity": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.6},
        "bootstrap_samples": {"type": "integer", "minimum": 0, "default": 1000}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "range": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "items": false
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "language"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "kind": {"enum": ["mfa_words", "manual_words", "commercial_cues", "manual_cues"]},
        "language": {"enum": ["en", "ja", "zh"]},
        "path": {"type": "string", "minLength": 1},
        "media": {"type": "string", "minLength": 1},
        "stream_index": {"type": ["integer", "null"], "minimum": 0},
        "expected_codec": {"type": ["string", "null"]},
        "quality": {"enum": ["gold-acoustic", "gold-display", "silver-display"]},
        "enabled": {"type": "boolean", "default": true}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"enum": ["mfa_words", "manual_words", "manual_cues"]}}},
          "then": {"required": ["path"]}
        },
        {
          "if": {"properties": {"kind": {"const": "commercial_cues"}}},
          "then": {"anyOf": [{"required": ["path"]}, {"required": ["media"]}]}
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "language", "hypothesis", "references"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "language": {"enum": ["en", "ja", "zh"]},
        "media": {"type": ["string", "null"]},
        "hypothesis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "pre_position_units": {"type": ["string", "null"]},
            "post_position_units": {"type": ["string", "null"]},
            "alignment_health": {"type": ["string", "null"]}
          }
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/reference"}
        },
        "include_ranges": {"type": "array", "items": {"$ref": "#/$defs/range"}},
        "exclude_ranges": {"type": "array", "items": {"$ref": "#/$defs/range"}},
        "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
