{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxweave.local/schemas/align-shadow-manifest.schema.json",
  "title": "Voxweave P6 align shadow manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_schema_version",
    "registry_sha256",
    "environment",
    "cases"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_schema_version": { "const": 2 },
    "registry_sha256": { "$ref": "#/$defs/sha256" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_major_minor",
        "platform",
        "locale",
        "timezone",
        "hash_seed"
      ],
      "properties": {
        "python_major_minor": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "platform": { "type": "string", "minLength": 1 },
        "locale": { "type": "string", "minLength": 1 },
        "timezone": { "type": ["string", "null"] },
        "hash_seed": { "type": ["string", "null"] }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "fileFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "selectedOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_family", "vtt", "json", "evidence"],
      "properties": {
        "engine_family": { "enum": ["legacy-v1", "boundary-v2"] },
        "vtt": { "$ref": "#/$defs/selectedOutput" },
        "json": { "$ref": "#/$defs/selectedOutput" },
        "evidence": { "$ref": "#/$defs/selectedOutput" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "values", "digest", "test_case_id"],
      "properties": {
        "kind": { "enum": ["production", "test-qualified"] },
        "values": { "type": "object" },
        "digest": { "$ref": "#/$defs/sha256" },
        "test_case_id": { "type": ["string", "null"] }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fully_admitted",
        "selected",
        "artifact_kind",
        "failure",
        "detail_code",
        "alds",
        "artifact_sha256"
      ],
      "properties": {
        "fully_admitted": { "type": "boolean" },
        "selected": { "$ref": "#/$defs/selected" },
        "artifact_kind": { "enum": ["rich", "minimal-failure", "none"] },
        "failure": { "type": ["string", "null"] },
        "detail_code": { "type": ["string", "null"] },
        "alds": {
          "type": "array",
          "items": { "pattern": "^ALD-[0-6]$" },
          "uniqueItems": true
        },
        "artifact_sha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "route",
        "effective_iso",
        "argv",
        "env",
        "inputs",
        "backend_receipt",
        "authority_limit_profile",
        "expected"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "route": { "enum": ["ctc-full", "mms-full", "qwen-crop"] },
        "effective_iso": { "type": "string", "minLength": 2 },
        "argv": {
          "type": "array",
          "items": { "type": "string" }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fileFact" }
        },
        "backend_receipt": { "$ref": "#/$defs/fileFact" },
        "authority_limit_profile": { "$ref": "#/$defs/profile" },
        "expected": { "$ref": "#/$defs/expected" }
      }
    }
  }
}
